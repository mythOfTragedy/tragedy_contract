{
  "name": "tragedy-nft-arweave-formal",
  "version": "1.0.0",
  "description": "Formal implementation of Tragedy NFT with Arweave hybrid approach",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy": "scripts/deploy/deploy.sh",
    "deploy:local": "hardhat run scripts/deploy/main.js --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy/main.js --network sepolia",
    "deploy:private": "hardhat run scripts/deploy/main.js --network private",
    "deploy:ethereum": "hardhat run scripts/deploy/main.js --network ethereum",
    "deploy:polygon": "hardhat run scripts/deploy/main.js --network polygon",
    "deploy:base": "hardhat run scripts/deploy/main.js --network base",
    "verify": "hardhat run scripts/deploy/verify.js --network",
    "verify:private": "hardhat run scripts/deploy/verify.js --network private",
    "verify:testnet": "hardhat run scripts/deploy/verify.js --network sepolia",
    "legacy:deploy": "hardhat run scripts/deploy-production.js --network bonsoleil",
    "legacy:deploy-workflow": "hardhat run scripts/01-deploy-all.js --network bonsoleil",
    "legacy:update-urls": "hardhat run scripts/02-update-urls.js --network bonsoleil",
    "legacy:test-composition": "hardhat run scripts/03-test-composition.js --network bonsoleil",
    "legacy:deploy-nft": "hardhat run scripts/04-deploy-nft.js --network bonsoleil",
    "legacy:test-minting": "hardhat run scripts/05-test-minting.js --network bonsoleil"
  },
  "keywords": [
    "nft",
    "arweave",
    "ethereum",
    "solidity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.0",
    "chai": "^4.2.0",
    "ethereum-waffle": "^3.0.0",
    "ethers": "^5.0.0",
    "hardhat": "^2.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.0.0"
  }
}
