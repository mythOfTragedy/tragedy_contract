# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URL - Used by deployment script to auto-detect network
# The deployment script will detect the network from this URL:
# - URLs containing "bon-soleil" → bonsoleil network
# - URLs containing "mainnet" → mainnet network
RPC_URL=https://dev2.bon-soleil.com/rpc

# Legacy: Specific network RPC URLs (optional)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
POLYGON_RPC_URL=https://polygon-rpc.com
BONSOLEIL_RPC_URL=https://dev2.bon-soleil.com/rpc

# Optional: Etherscan API keys for verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key