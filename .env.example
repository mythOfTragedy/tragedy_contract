# === REQUIRED: Basic Configuration ===
# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# === PRIVATE CHAIN CONFIGURATION ===
# These three values work together for private chain deployment
RPC_URL=https://your-private-chain.com/rpc
CHAIN_ID=31337

# === OPTIONAL: Public Network RPC URLs ===
# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key

# Base Mainnet
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key

# Sepolia Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: Etherscan API keys for verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key